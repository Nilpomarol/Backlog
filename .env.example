# Browser configuration from your Firebase web app.
# These values are embedded in the client bundle and identify the Firebase app;
# they are not server credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: required only when image upload/storage is enabled.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Worker runtime configuration. FIREBASE_PROJECT_ID normally matches the public
# Firebase project ID, but is kept separate because it is read server-side.
FIREBASE_PROJECT_ID=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Used only by `npm run db:setup` to create or restore the first administrator.
# Do not configure these in Cloudflare.
ADMIN_EMAIL=
ADMIN_NAME=
